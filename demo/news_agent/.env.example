# Historical technology-news corpus
OPENSEARCH_HOST=127.0.0.1
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=techcomp-vector-chunks
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RAG_TOP_K=5
RAG_NUM_CANDIDATES=5
RAG_MAX_CHUNKS_PER_SOURCE=2
EVIDENCE_SNIPPET_MAX_CHARS=1200

# Nemotron routing and verification service
ORCH_URL=http://127.0.0.1:8002/v1
ORCH_API_KEY=not-needed
ORCH_MODEL=nvidia/Nemotron-Orchestrator-8B
ORCH_REQUEST_TIMEOUT=600

# Qwen answer synthesis service
LLM_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=not-needed
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_REQUEST_TIMEOUT=600

# Bounded agent loop
NEWS_MAX_RETRIES=1
REQUIRE_LLM_VERIFIER=true
MAX_QUERY_CHARS=32768

# Governance check gates
RELEASE_CHECKS_ENABLED=true
POLICY_CHECKS_ENABLED=true
EVIDENCE_CHECKS_ENABLED=true

# Tavily Streamable HTTP MCP server and client
TAVILY_API_KEY=
TAVILY_MCP_HOST=127.0.0.1
TAVILY_MCP_PORT=8765
TAVILY_MCP_PATH=/mcp
TAVILY_MCP_URL=http://127.0.0.1:8765/mcp
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_TIMEOUT=30
WEB_SEARCH_DEFAULT_TIME_RANGE=month
WEB_RESULT_MAX_CHARS=1400
MCP_CALL_TIMEOUT=30

# Audit. Query text is omitted by default; hashes and lengths are still recorded.
AUDIT_LOG_PATH=./logs/news-agent-audit.jsonl
AUDIT_INCLUDE_QUERY=false

# A2A server
A2A_HOST=0.0.0.0
A2A_PORT=9001
APP_URL=http://127.0.0.1:9001
