# Financial Agent A2A 1.0 endpoint
FINANCIALS_AGENT_HOST=0.0.0.0
FINANCIALS_AGENT_PORT=9002
FINANCIALS_AGENT_URL=http://127.0.0.1:9002

# Official MCP 2.0 Streamable HTTP endpoint
FINANCIALS_MCP_HOST=0.0.0.0
FINANCIALS_MCP_PORT=8766
FINANCIALS_MCP_URL=http://127.0.0.1:8766/mcp
FINNHUB_API_KEY=
FINNHUB_API_BASE=https://finnhub.io/api/v1

# Nemotron planning and advisory verification service
ORCH_URL=http://127.0.0.1:8002/v1
ORCH_API_KEY=not-needed
ORCH_MODEL=nvidia/Nemotron-Orchestrator-8B
ORCH_REQUEST_TIMEOUT=600

# Qwen evidence-grounded synthesis service
LLM_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=not-needed
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_REQUEST_TIMEOUT=600

# Shared generation controls
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_MAX_TOKENS=131072

# Financial-filings vector index
OPENSEARCH_HOST=127.0.0.1
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=financial-filings-vector-chunks
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RAG_TOP_K=3
RAG_NUM_CANDIDATES=3

# Governance and diagnostics
AUDIT_LOG_PATH=./var/financials-audit.jsonl
# Governance checks are enabled by default and may be disabled independently.
RELEASE_CHECKS_ENABLED=true
POLICY_CHECKS_ENABLED=true
EVIDENCE_CHECKS_ENABLED=true
SHOW_TRACE=false
# DEBUG logs full boundary payloads, including prompts, evidence, and answers.
LOG_LEVEL=INFO
