# Public Orchestrator API
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=10000
ORCHESTRATOR_PUBLIC_MODEL=vertical-api-orchestrator

# Nemotron control-plane model
ORCH_URL=http://127.0.0.1:8002/v1
ORCH_API_KEY=not-needed
ORCH_MODEL=nvidia/Nemotron-Orchestrator-8B
ORCH_REQUEST_TIMEOUT=600
ORCH_MAX_TOKENS=131072

# External synthesis model used only when News and Financial results are combined
LLM_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=not-needed
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_MAX_TOKENS=131072
LLM_REQUEST_TIMEOUT=600

# Optional external OpenAI-compatible model routing
USE_EXTERNAL_AI=false
USE_EXTERNAL_ORCH_AI=false
USE_EXTERNAL_LLM_AI=false
USE_EXTERNAL_OPENAI=false
# EXTERNAL_ORCH_URL=https://api.openai.com/v1
# EXTERNAL_ORCH_API_KEY=
# EXTERNAL_ORCH_MODEL=
# EXTERNAL_ORCH_MAX_TOKENS=131072
# EXTERNAL_LLM_URL=https://api.openai.com/v1
# EXTERNAL_LLM_API_KEY=
# EXTERNAL_LLM_MODEL=
# EXTERNAL_LLM_MAX_TOKENS=131072
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4

# Existing external A2A specialist services
NEWS_AGENT_URL=http://127.0.0.1:9001
FINANCIAL_AGENT_URL=http://127.0.0.1:9002
A2A_TIMEOUT_SECONDS=600

# Demonstration audit trail
AUDIT_LOG_PATH=./logs/orchestrator-audit.jsonl
AUDIT_INCLUDE_QUERY=false
MAX_QUERY_CHARS=32768

# Governance check gates
RELEASE_CHECKS_ENABLED=true
POLICY_CHECKS_ENABLED=true
EVIDENCE_CHECKS_ENABLED=true
